let a = "global"
{
  let a = "block"
  print(a)
  {
    let a = "inner"
    print(a)
  }
  print(a)
}
print(a)
// expect: block
// expect: inner
// expect: block
// expect: global

// the initializer sees the outer variable, not the one being declared
let v = 1
{
  let v = v + 1
  print(v)
}
// expect: 2

fn shadow(a) {
  let b = a * 2
  {
    let a = "shadowed"
    b = b + 1
  }
  return [a, b]
}
print(shadow(10))
// expect: [10, 21]
