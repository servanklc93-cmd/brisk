fn fib(n) {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}
print(fib(25))
// expect: 75025

fn isEven(n) {
  if n == 0 { return true }
  return isOdd(n - 1)
}
fn isOdd(n) {
  if n == 0 { return false }
  return isEven(n - 1)
}
print(isEven(100), isOdd(7))
// expect: true true

// local recursive function
fn run() {
  fn fact(n) {
    if n <= 1 { return 1 }
    return n * fact(n - 1)
  }
  return fact(10)
}
print(run())
// expect: 3628800
