let xs = [3, 1, 2]
xs.push(5, 4)
print(xs, len(xs))
// expect: [3, 1, 2, 5, 4] 5
print(xs.sort(), xs)
// expect: [1, 2, 3, 4, 5] [3, 1, 2, 5, 4]
xs[0] = 10
xs[-1] += 1
print(xs, xs.pop(), xs)
// expect: [10, 1, 2, 5] 5 [10, 1, 2, 5]
print([1, 2] + [3], [1, 2, 3].slice(1, 3), [1, 2, 3].reverse())
// expect: [1, 2, 3] [2, 3] [3, 2, 1]

let m = {"a": 1, 2: "two", true: "yes"}
m["b"] = 2
m["a"] += 10
print(m["a"], m[2], m[true], m["missing"])
// expect: 11 two yes nil
print(m.keys(), m.has("b"), m.get("zzz", 0))
// expect: ["a", 2, true, "b"] true 0
m.remove(2)
print(m.len())
// expect: 3

print(map(1..5, fn(x) { return x * x }))
// expect: [1, 4, 9, 16]
print(filter([1, 2, 3, 4, 5, 6], fn(x) { return x % 2 == 0 }))
// expect: [2, 4, 6]
print(sum([1, 2, 3]), reduce(["a", "b"], fn(acc, x) { return acc + x }, ">"))
// expect: 6 >ab
print(enumerate(["x", "y"]))
// expect: [[0, "x"], [1, "y"]]

// a list that contains itself doesn't hang print
let loop = [1]
loop.push(loop)
print(loop)
// expect: [1, [...]]
